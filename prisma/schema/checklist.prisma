// =============================================================================
// Generic checklist engine — ADR-006.
// Serves onboarding, offboarding, clearance, and return confirmation from one
// set of tables, so templates are admin-configurable without a migration.
// =============================================================================

enum ChecklistType {
  ONBOARDING
  OFFBOARDING
  CLEARANCE
}

/// The department accountable for a step. Drives the clearance form grouping.
enum ChecklistCategory {
  HR
  IT
  ADMIN
  FINANCE
  ACCOMMODATION
  FLEET
  MANAGEMENT
}

enum ChecklistStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ChecklistItemStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  NOT_APPLICABLE
  BLOCKED
}

model ChecklistTemplate {
  id        String        @id @default(cuid(2))
  key       String        @unique
  name      String
  type      ChecklistType
  /// Null = applies to every company.
  companyId String?
  isActive  Boolean       @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company?                @relation(fields: [companyId], references: [id])
  items     ChecklistTemplateItem[]
  instances ChecklistInstance[]

  @@index([type, isActive])
  @@index([companyId])
}

model ChecklistTemplateItem {
  id         String            @id @default(cuid(2))
  templateId String
  order      Int
  label      String
  category   ChecklistCategory

  responsibleDepartmentId String?
  responsibleRoleId       String?
  requiresAttachment      Boolean @default(false)
  requiresDate            Boolean @default(false)
  /// Due-date offset in days from the instance start.
  defaultDueDays          Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  template               ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  responsibleDepartment  Department?       @relation(fields: [responsibleDepartmentId], references: [id])

  items ChecklistItem[]

  @@unique([templateId, order])
  @@index([responsibleDepartmentId])
}

model ChecklistInstance {
  id         String        @id @default(cuid(2))
  templateId String
  type       ChecklistType
  employeeId String
  companyId  String

  status      ChecklistStatus @default(IN_PROGRESS)
  startedAt   DateTime        @default(now())
  targetDate  DateTime?
  completedAt DateTime?
  createdById String
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  template ChecklistTemplate @relation(fields: [templateId], references: [id])
  employee Employee          @relation(fields: [employeeId], references: [id])
  company  Company           @relation(fields: [companyId], references: [id])
  items    ChecklistItem[]

  @@index([employeeId, type])
  @@index([status, type])
  @@index([companyId, type])
  @@index([templateId])
}

model ChecklistItem {
  id             String  @id @default(cuid(2))
  instanceId     String
  templateItemId String?
  order          Int
  label          String
  category       ChecklistCategory

  status        ChecklistItemStatus @default(PENDING)
  assignedToId  String?
  dueDate       DateTime?

  /// Copied from the template at instantiation, not read through it (ADR-006):
  /// a checklist in progress keeps its own copy, so editing a template cannot
  /// change who is allowed to sign off an exit that is already running.
  responsibleDepartmentId String?
  responsibleRoleId       String?
  completedAt   DateTime?
  completedById String?
  attachmentId  String?
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  instance     ChecklistInstance      @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  templateItem ChecklistTemplateItem? @relation(fields: [templateItemId], references: [id])
  attachment   FileObject?            @relation(fields: [attachmentId], references: [id])

  @@index([instanceId, order])
  @@index([assignedToId, status])
  @@index([status, dueDate])
  @@index([templateItemId])
  @@index([attachmentId])
}

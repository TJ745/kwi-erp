// =============================================================================
// IT: assets (with handover lifecycle) and infrastructure.
// =============================================================================

enum AssetType {
  LAPTOP
  DESKTOP
  MONITOR
  PRINTER
  MOBILE
  TABLET
  IP_PHONE
  CCTV_CAMERA
  CCTV_RECORDER
  NETWORK
  SERVER
  PERIPHERAL
  OTHER
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  UNDER_REPAIR
  LOST
  RETIRED
  DISPOSED
}

enum AssetCondition {
  NEW
  GOOD
  FAIR
  POOR
  DAMAGED
}

enum CctvType {
  DOME
  BULLET
  PTZ
  NVR
  DVR
}

model ITAsset {
  id           String    @id @default(cuid(2))
  assetCode    String    @unique
  assetTag     String?   @unique
  type         AssetType
  brand        String
  model        String
  serialNumber String?   @unique
  /// Network hardware address, stored uppercase and colon-delimited.
  macAddress   String?   @unique
  /// The device's IP. Unique across the estate: two devices on one address is
  /// an outage. The Device IPs page is a view over this column.
  ipAddress    String?   @unique
  companyId    String

  purchaseDate   DateTime?
  purchaseCost   Decimal?  @db.Decimal(14, 2)
  currency       String    @default("SAR")
  warrantyExpiry DateTime?

  status         AssetStatus    @default(AVAILABLE)
  condition      AssetCondition @default(GOOD)
  location       String?
  specifications Json?
  notes          String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company Company @relation(fields: [companyId], references: [id])

  assignments ITAssetAssignment[]
  ipPhone     IpPhone?
  cctv        CctvDevice?

  @@index([status, type])
  @@index([companyId, status])
  @@index([warrantyExpiry])
  @@index([deletedAt])
}

/// Handover-out and handover-in are two ends of one row.
///
/// A partial unique index (added in a follow-up SQL migration) enforces
/// "one active assignment per asset":
///   CREATE UNIQUE INDEX it_asset_single_active_assignment
///     ON "ITAssetAssignment" ("assetId") WHERE "returnedAt" IS NULL;
model ITAssetAssignment {
  id           String   @id @default(cuid(2))
  assetId      String
  employeeId   String
  assignedAt   DateTime
  assignedById String

  conditionOut   AssetCondition
  accessoriesOut Json?
  remarksOut     String?
  acknowledgedAt DateTime?

  returnedAt         DateTime?
  receivedById       String?
  conditionIn        AssetCondition?
  missingAccessories Json?
  remarksIn          String?
  handoverDocumentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  asset            ITAsset     @relation(fields: [assetId], references: [id])
  employee         Employee    @relation(fields: [employeeId], references: [id])
  handoverDocument FileObject? @relation(fields: [handoverDocumentId], references: [id])

  @@index([assetId, returnedAt])
  @@index([employeeId, returnedAt])
  @@index([handoverDocumentId])
}

// -----------------------------------------------------------------------------
// Infrastructure. The hardware itself is always an ITAsset; these rows add only
// what is specific to telephony and CCTV.
// -----------------------------------------------------------------------------

/// A phone extension and the handset it rings on. Everything about the
/// handset — model, MAC, location, status, who holds it — lives on the asset,
/// so it is recorded once. One extension per handset.
model IpPhone {
  id        String @id @default(cuid(2))
  extension String @unique
  assetId   String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  asset ITAsset @relation(fields: [assetId], references: [id])
}

/// A CCTV camera or recorder. The hardware — name, model, serial, location,
/// IP, status, warranty — is the linked IT asset; this row holds only what is
/// CCTV-specific: the camera type, which recorder it records to, and upkeep.
model CctvDevice {
  id                String    @id @default(cuid(2))
  assetId           String    @unique
  type              CctvType
  recorderId        String?
  lastMaintenanceAt DateTime?
  notes             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  asset    ITAsset      @relation(fields: [assetId], references: [id])
  recorder CctvDevice?  @relation("CctvRecorder", fields: [recorderId], references: [id])
  cameras  CctvDevice[] @relation("CctvRecorder")

  @@index([recorderId])
}

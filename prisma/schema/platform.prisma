// =============================================================================
// Platform: tasks, notifications, audit, expiry projection, letter templates.
// =============================================================================

enum TaskStatus {
  TODO
  IN_PROGRESS
  WAITING
  COMPLETED
  CANCELLED
}

/// Every record type that carries an expiry date. Adding a member here is how
/// a new expiry source joins the reminder engine — ADR-005.
enum ExpirySource {
  IQAMA
  PASSPORT
  EMPLOYEE_CONTRACT
  DOCUMENT
  COMPANY_CERTIFICATE
  VEHICLE_REGISTRATION
  VEHICLE_INSURANCE
  SUBCONTRACTOR_CONTRACT
  SUPPLIER_CONTRACT
  MEDICAL_INSURANCE_POLICY
  IT_ASSET_WARRANTY
  SOFTWARE_LICENSE
}

enum NotificationKind {
  EXPIRY
  TASK_DUE
  TASK_OVERDUE
  APPROVAL_REQUIRED
  TICKET_ASSIGNED
  MENTION
  SYSTEM
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  APPROVE
  REJECT
  ASSIGN
  UNASSIGN
  RETURN
  UPLOAD
  DOWNLOAD
  VIEW
  GENERATE
  COMPLETE
  LOGIN
  LOGOUT
  LOGIN_FAILED
  PERMISSION_CHANGE
  EXPORT
}

enum LetterType {
  JOINING_LETTER
  JOB_OFFER
  EMPLOYMENT_LETTER
  SALARY_LETTER
  EXPERIENCE_LETTER
  WARNING_LETTER
  CLEARANCE_FORM
  VEHICLE_HANDOVER
  ASSET_HANDOVER
  RETURN_CONFIRMATION
  MEMO
  OTHER
}

enum LetterStatus {
  GENERATED
  ISSUED
  CANCELLED
}

model Task {
  id          String  @id @default(cuid(2))
  taskNo      String  @unique
  companyId   String
  title       String
  description String?

  status   TaskStatus @default(TODO)
  priority Priority   @default(MEDIUM)

  assignedToId String?
  createdById  String
  dueDate      DateTime?
  followUpDate DateTime?
  completedAt  DateTime?

  /// Polymorphic link to the record this task is about.
  entityType   EntityType?
  entityId     String?
  parentTaskId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company  @relation(fields: [companyId], references: [id])
  parentTask Task?    @relation("TaskSubtasks", fields: [parentTaskId], references: [id])
  subtasks   Task[]   @relation("TaskSubtasks")

  comments TaskComment[]

  @@index([assignedToId, status])
  @@index([status, dueDate])
  @@index([entityType, entityId])
  @@index([companyId, status])
  @@index([createdById])
  @@index([parentTaskId])
}

model TaskComment {
  id       String   @id @default(cuid(2))
  taskId   String
  authorId String
  body     String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

// -----------------------------------------------------------------------------
// Expiry projection — ADR-005.
//
// Written inside the same transaction as the source mutation, and rebuilt
// nightly by reconcileExpiryIndex() so missed writes self-heal.
//
// Status (VALID / EXPIRING_SOON / EXPIRED) is NEVER stored — it is derived from
// expiryDate at read time. See lib/expiry.ts.
// -----------------------------------------------------------------------------

model ExpiryIndex {
  id         String       @id @default(cuid(2))
  source     ExpirySource
  /// Primary key of the originating row.
  sourceId   String
  companyId  String?
  employeeId String?
  vehicleId  String?

  label       String
  expiryDate  DateTime
  warningDays Int[]    @default([90, 60, 30, 15, 7, 1])
  /// False once the source row is superseded, renewed, or deleted.
  isActive    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([source, sourceId])
  @@index([isActive, expiryDate])
  @@index([companyId, isActive, expiryDate])
  @@index([employeeId])
  @@index([vehicleId])
}

model NotificationRule {
  id         String                @id @default(cuid(2))
  name       String
  kind       NotificationKind
  source     ExpirySource?
  thresholds Int[]                 @default([90, 60, 30, 15, 7, 1, 0])
  roleIds    String[]
  channels   NotificationChannel[] @default([IN_APP])
  isActive   Boolean               @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, isActive])
}

model Notification {
  id       String           @id @default(cuid(2))
  userId   String
  kind     NotificationKind
  severity Severity         @default(INFO)
  title    String
  body     String?

  entityType EntityType?
  entityId   String?

  /// Prevents duplicate reminders: "IQAMA:<sourceId>:30:<userId>".
  dedupeKey String @unique

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
  @@index([createdAt])
}

/// Append-only. The application has no update or delete path for this table;
/// database privileges are expected to enforce the same. Sensitive values are
/// redacted before write — see docs/SECURITY.md §7.
model AuditLog {
  id          String  @id @default(cuid(2))
  actorUserId String?
  /// Denormalised so the trail stays readable after a user is removed.
  actorLabel  String

  action     AuditAction
  entityType EntityType
  entityId   String
  companyId  String?

  summary String
  /// { field: { before, after } } with REDACTED_FIELDS masked.
  changes Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([createdAt])
  @@index([action, createdAt])
  @@index([companyId, createdAt])
}

model LetterTemplate {
  id        String     @id @default(cuid(2))
  key       String     @unique
  name      String
  type      LetterType
  companyId String?
  /// Sanitised on save against a tag/attribute allowlist.
  bodyHtml  String
  /// Declared placeholders: [{ key, label, required }].
  variables Json
  /// Arabic body for bilingual letters (Decision D). Rendered with dir="rtl".
  bodyHtmlAr String?
  isActive  Boolean    @default(true)
  version   Int        @default(1)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company Company? @relation(fields: [companyId], references: [id])

  generated GeneratedLetter[]

  @@index([type, isActive])
  @@index([companyId])
}

model GeneratedLetter {
  id         String     @id @default(cuid(2))
  letterNo   String     @unique
  templateId String
  companyId  String
  entityType EntityType
  entityId   String
  employeeId String?

  renderedHtml String
  /// Values frozen at generation time: a salary letter must keep saying what
  /// it said when issued, even after the salary changes.
  dataSnapshot Json
  fileId       String?

  status        LetterStatus @default(GENERATED)
  generatedById String
  generatedAt   DateTime     @default(now())

  template LetterTemplate @relation(fields: [templateId], references: [id])
  company  Company        @relation(fields: [companyId], references: [id])
  employee Employee?      @relation(fields: [employeeId], references: [id])
  file     FileObject?    @relation(fields: [fileId], references: [id])

  @@index([entityType, entityId])
  @@index([templateId, generatedAt])
  @@index([companyId, generatedAt])
  @@index([employeeId])
  @@index([fileId])
}

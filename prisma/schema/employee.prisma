// =============================================================================
// Employee master record. Sensitive data (bank, salary-bearing contracts) is
// split into its own tables so it can sit behind its own permission.
// =============================================================================

enum Gender {
  MALE
  FEMALE
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  RESIGNED
  TERMINATED
  EXITED
  INACTIVE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
  INTERN
}

enum RenewalStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  COMPLETED
  REJECTED
}

model Employee {
  id           String  @id @default(cuid(2))
  employeeNo   String  @unique
  companyId    String
  departmentId String?
  positionId   String?
  managerId    String?

  firstName  String
  /// Father's name and grandfather's name. Optional because not every record
  /// has them, but they are not decoration: Saudi identity documents and
  /// government forms — the clearance form among them — address a person by
  /// all four parts, so a letter that can only print two has to be retyped.
  middleName String?
  lastName   String
  familyName String?
  /// Denormalised for search; maintained by the service layer.
  fullName   String
  fullNameAr String?

  gender        Gender
  dateOfBirth   DateTime?
  /// ISO-3166 alpha-2.
  nationality   String
  maritalStatus MaritalStatus?

  status          EmployeeStatus @default(ACTIVE)
  employmentType  EmploymentType @default(FULL_TIME)
  joiningDate     DateTime
  lastWorkingDate DateTime?

  mobile        String?
  workEmail     String? @unique
  personalEmail String?
  photoFileId   String?
  notes         String?

  /// Monthly salary. Sensitive: read needs employees.salary.view, write
  /// employees.salary.manage. Increment lists take "current salary" from here.
  basicSalary        Decimal? @db.Decimal(12, 2)
  transportAllowance Decimal? @db.Decimal(12, 2)
  housingAllowance   Decimal? @db.Decimal(12, 2)
  /// Mobile / food allowance.
  otherAllowance     Decimal? @db.Decimal(12, 2)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company    Company     @relation(fields: [companyId], references: [id])
  department Department? @relation("EmployeeDepartment", fields: [departmentId], references: [id])
  position   Position?   @relation(fields: [positionId], references: [id])
  manager    Employee?   @relation("EmployeeManager", fields: [managerId], references: [id])
  photo      FileObject? @relation("EmployeePhoto", fields: [photoFileId], references: [id])

  reports           Employee[]   @relation("EmployeeManager")
  headedDepartments Department[] @relation("DepartmentHead")
  userAccount       User?        @relation("EmployeeUserAccount")

  bankDetail        EmployeeBankDetail?
  iqama             IqamaRecord?
  passport          PassportRecord?
  emergencyContacts EmergencyContact[]

  contracts        Contract[]
  leaveRequests    LeaveRequest[]      @relation("LeaveEmployee")
  approvedLeaves   LeaveRequest[]      @relation("LeaveApprover")
  handoverLeaves   LeaveRequest[]      @relation("LeaveHandover")
  evaluations      Evaluation[]        @relation("EvaluationSubject")
  evaluationsGiven Evaluation[]        @relation("EvaluationManager")
  incrementLines   IncrementListLine[]
  warnings         WarningLetter[]
  jobOfferOrigin   JobOffer[]          @relation("OfferConvertedEmployee")
  joiningLetters   JoiningLetter[]
  timesheetRows    TimesheetEntry[]
  clearanceForms   ClearanceForm[]

  assetAssignments    ITAssetAssignment[]
  bedAssignments      BedAssignment[]
  vehicleAssignments  VehicleAssignment[]
  drivenVehicles      Vehicle[]            @relation("VehicleCurrentDriver")
  vehicleHandoverFrom VehicleHandover[]    @relation("HandoverFromEmployee")
  vehicleHandoverTo   VehicleHandover[]    @relation("HandoverToEmployee")
  maintenanceDriven   VehicleMaintenance[] @relation("MaintenanceDriver")
  insuranceMembership EmployeeInsurance[]
  generatedLetters    GeneratedLetter[]
  expiryIndex         ExpiryIndex[]

  @@index([companyId, status])
  @@index([departmentId])
  @@index([managerId])
  @@index([positionId])
  @@index([fullName])
  @@index([status, joiningDate])
  @@index([deletedAt])
}

/// Sensitive. Gated by employees.bank.view — never returned by list endpoints.
model EmployeeBankDetail {
  id         String    @id @default(cuid(2))
  employeeId String    @unique
  bankName   String
  iban       String
  accountNo  String?
  swift      String?
  documentId String?
  verifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model EmergencyContact {
  id         String  @id @default(cuid(2))
  employeeId String
  name       String
  relation   String
  phone      String
  altPhone   String?
  address    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

/// Current Iqama only — one row per employee keeps expiry queries trivial.
/// Historical renewals live in IqamaRenewal.
model IqamaRecord {
  id            String        @id @default(cuid(2))
  employeeId    String        @unique
  iqamaNumber   String        @unique
  profession    String
  professionAr  String?
  issueDate     DateTime
  expiryDate    DateTime
  sponsorName   String?
  renewalStatus RenewalStatus @default(NOT_STARTED)
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  renewals IqamaRenewal[]

  @@index([expiryDate])
  @@index([renewalStatus])
}

model IqamaRenewal {
  id             String        @id @default(cuid(2))
  iqamaRecordId  String
  previousExpiry DateTime
  newExpiry      DateTime?
  submittedAt    DateTime?
  completedAt    DateTime?
  status         RenewalStatus @default(NOT_STARTED)
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  iqamaRecord IqamaRecord @relation(fields: [iqamaRecordId], references: [id], onDelete: Cascade)

  @@index([iqamaRecordId])
  @@index([status])
}

model PassportRecord {
  id             String   @id @default(cuid(2))
  employeeId     String   @unique
  passportNumber String
  issueCountry   String
  issuePlace     String?
  issueDate      DateTime
  expiryDate     DateTime
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([passportNumber, issueCountry])
  @@index([expiryDate])
}

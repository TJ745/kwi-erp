// =============================================================================
// OMS — datasource, generator, and cross-cutting enums.
// See docs/DATABASE.md for the full design rationale.
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../../src/generated/prisma"
}

// Prisma 7 no longer accepts connection URLs here. The migration URL lives in
// prisma.config.ts; the runtime connection is supplied by the Neon driver
// adapter in src/server/db/client.ts.
datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Shared enums used across more than one module.
// -----------------------------------------------------------------------------

/// Generic lifecycle flag for reference-style records.
enum RecordStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

/// Target of a polymorphic reference (Document, Attachment, AuditLog).
/// Adding a member here is the only supported way to make a new entity
/// attachable — see docs/DATABASE.md §6.
///
/// Retired modules (tasks, helpdesk, servers, network devices, software
/// licences, suppliers, petty cash, electricity bills, onboarding and
/// offboarding checklists) keep their members so
/// historic audit rows stay readable. Nothing new is written against them.
enum EntityType {
  EMPLOYEE
  COMPANY
  DEPARTMENT
  VEHICLE
  /// A single service record, not the vehicle. A workshop invoice belongs to
  /// the job it paid for — attaching it to the vehicle loses which of forty
  /// services it covers.
  VEHICLE_MAINTENANCE
  IT_ASSET
  IT_TICKET
  SERVER
  NETWORK_DEVICE
  CCTV_DEVICE
  IP_PHONE
  SOFTWARE_LICENSE
  CREDENTIAL
  SUPPLIER
  SUBCONTRACTOR
  CONTRACT
  LEAVE_REQUEST
  EVALUATION
  WARNING_LETTER
  INCREMENT
  JOB_OFFER
  CORRESPONDENCE
  CHECKLIST_INSTANCE
  CHECKLIST_ITEM
  TASK
  ACCOMMODATION
  BED_ASSIGNMENT
  PETTY_CASH_TRANSACTION
  ELECTRICITY_BILL
  COMPANY_CERTIFICATE
  MEDICAL_INSURANCE_POLICY
  GENERATED_LETTER
  LETTER_TEMPLATE
  USER
  ROLE
  UTILITY_METER
  TIMESHEET_FILE
  IP_ADDRESS
  PERSONNEL_REQUEST
  INTERVIEW_EVALUATION
  JOINING_LETTER
  CLEARANCE_FORM
  TIMESHEET
}

enum Severity {
  INFO
  WARNING
  CRITICAL
}

/// Generic approval lifecycle shared by leave, increments, maintenance.
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum GrantEffect {
  ALLOW
  DENY
}

/// Post-upload validation state. Files are invisible to the app until CLEAN.
enum ScanStatus {
  PENDING
  CLEAN
  REJECTED
}

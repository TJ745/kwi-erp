// =============================================================================
// HR: contracts, leave, timesheet, evaluation, increments, warnings, offers.
// =============================================================================

enum ContractType {
  PERMANENT
  FIXED_TERM
  PROBATION
  TEMPORARY
  CONSULTANCY
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
  RENEWED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum WarningLevel {
  VERBAL
  FIRST_WRITTEN
  SECOND_WRITTEN
  FINAL
}

enum OfferStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  WITHDRAWN
  CONVERTED
}

model Contract {
  id               String       @id @default(cuid(2))
  employeeId       String
  companyId        String
  contractType     ContractType
  startDate        DateTime
  endDate          DateTime?
  probationEndDate DateTime?

  /// Sensitive — gated by employees.salary.view.
  basicSalary Decimal? @db.Decimal(14, 2)
  /// { housing, transport, other } — shape validated by Zod at the service.
  allowances  Json?
  currency    String   @default("SAR")

  status     ContractStatus @default(ACTIVE)
  documentId String?
  notes      String?

  /// The printed employment contract.
  contractDate     DateTime?
  positionTitle    String?
  jobDescriptionId String?
  termYears        Int       @default(1)
  workDaysPerWeek  Int       @default(5)
  hoursPerDay      Int       @default(8)
  /// The employee's particulars as printed (names, nationality, IDs,
  /// addresses, home phone) and the ticket destination / family. A snapshot:
  /// the signed contract keeps what it said. Shape validated by Zod.
  particulars      Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  employee Employee    @relation(fields: [employeeId], references: [id])
  company  Company     @relation(fields: [companyId], references: [id])
  document FileObject? @relation(fields: [documentId], references: [id])

  @@index([employeeId, status])
  @@index([endDate])
  @@index([companyId, status])
  @@index([documentId])
}

model LeaveType {
  id                 String  @id @default(cuid(2))
  key                String  @unique
  name               String
  isPaid             Boolean @default(true)
  maxDaysPerYear     Int?
  requiresAttachment Boolean @default(false)
  isSystem           Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requests LeaveRequest[]
}

model LeaveRequest {
  id          String   @id @default(cuid(2))
  employeeId  String
  leaveTypeId String
  startDate   DateTime
  endDate     DateTime
  days        Decimal  @db.Decimal(5, 1)
  reason      String?

  status          LeaveStatus @default(PENDING)
  approverId      String?
  decidedAt       DateTime?
  decisionComment String?
  handoverToId    String?
  /// The rest of the printed Leave Request form (src/lib/leave-form.ts).
  form            Json?
  /// Set when this leave extends another: it starts the day after that one ends.
  extendsLeaveId  String?
  createdById     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee   Employee  @relation("LeaveEmployee", fields: [employeeId], references: [id])
  leaveType  LeaveType @relation(fields: [leaveTypeId], references: [id])
  approver   Employee? @relation("LeaveApprover", fields: [approverId], references: [id])
  handoverTo Employee? @relation("LeaveHandover", fields: [handoverToId], references: [id])
  extendsLeave LeaveRequest?  @relation("LeaveExtension", fields: [extendsLeaveId], references: [id], onDelete: Restrict)
  extensions   LeaveRequest[] @relation("LeaveExtension")

  @@index([employeeId, status])
  @@index([status, startDate])
  @@index([leaveTypeId])
  @@index([approverId])
  @@index([handoverToId])
  @@index([extendsLeaveId])
}

/// One timesheet file per company per month. The timesheet itself is kept in
/// Excel; the system stores the file and says which company and month it is.
model TimesheetFile {
  id           String   @id @default(cuid(2))
  companyId    String
  /// Always the first day of the month.
  month        DateTime @db.Date
  fileId       String   @unique
  notes        String?
  uploadedById String

  createdAt DateTime @default(now())

  company Company    @relation(fields: [companyId], references: [id])
  file    FileObject @relation(fields: [fileId], references: [id])

  @@unique([companyId, month])
  @@index([month])
}

enum EvaluationTemplate {
  STAFF
  WORKER
}

/// An evaluation round, e.g. "Annual Evaluation 2026": a list of employees,
/// each evaluated on the Staff or the Worker form.
model EvaluationList {
  id          String   @id @default(cuid(2))
  title       String
  listDate    DateTime
  notes       String?
  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evaluations Evaluation[]

  @@index([listDate])
}

/// One employee's filled form. The form body (goals, competencies, scores,
/// development plan) is JSON whose shape is fixed per template and validated
/// by Zod on every save — the forms are documents, not query targets.
model Evaluation {
  id             String             @id @default(cuid(2))
  listId         String
  employeeId     String
  template       EvaluationTemplate
  evaluationDate DateTime

  /// Staff form: the evaluating manager, and plan dates.
  managerId      String?
  timeInPosition String?
  pdpStarted     DateTime?
  pdpCompleted   DateTime?
  /// Worker form.
  section        String?

  data             Json
  managerComments  String?
  employeeComments String?
  /// Staff form: typed by the evaluator.
  finalRating      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  list     EvaluationList @relation(fields: [listId], references: [id], onDelete: Cascade)
  employee Employee       @relation("EvaluationSubject", fields: [employeeId], references: [id])
  manager  Employee?      @relation("EvaluationManager", fields: [managerId], references: [id])

  @@unique([listId, employeeId])
  @@index([employeeId, evaluationDate])
  @@index([managerId])
}

/// A salary increment list: employees, their current salary, the salary they
/// demanded and the salary proposed. A document to print and file; it never
/// changes anyone's salary.
model IncrementList {
  id          String   @id @default(cuid(2))
  title       String
  listDate    DateTime
  notes       String?
  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines IncrementListLine[]

  @@index([listDate])
}

/// One employee on a list. Current figures are copied from the employee when
/// added, so the list keeps showing what the salary WAS at the time. Demanded
/// and proposed start equal to current; the increment is the difference.
model IncrementListLine {
  id         String @id @default(cuid(2))
  listId     String
  employeeId String
  sortOrder  Int

  curBasic     Decimal @default(0) @db.Decimal(12, 2)
  curTransport Decimal @default(0) @db.Decimal(12, 2)
  curHousing   Decimal @default(0) @db.Decimal(12, 2)
  curOther     Decimal @default(0) @db.Decimal(12, 2)

  demBasic     Decimal @default(0) @db.Decimal(12, 2)
  demTransport Decimal @default(0) @db.Decimal(12, 2)
  demHousing   Decimal @default(0) @db.Decimal(12, 2)
  demOther     Decimal @default(0) @db.Decimal(12, 2)

  propBasic     Decimal @default(0) @db.Decimal(12, 2)
  propTransport Decimal @default(0) @db.Decimal(12, 2)
  propHousing   Decimal @default(0) @db.Decimal(12, 2)
  propOther     Decimal @default(0) @db.Decimal(12, 2)

  list     IncrementList @relation(fields: [listId], references: [id], onDelete: Cascade)
  employee Employee      @relation(fields: [employeeId], references: [id])

  @@unique([listId, employeeId])
  @@index([employeeId])
}

model WarningLetter {
  id            String       @id @default(cuid(2))
  employeeId    String
  level         WarningLevel
  reason        String
  /// The incident sentence of the printed letter, in English and Arabic.
  description   String
  descriptionAr String?
  /// Optional project or site, printed in brackets after the incident.
  project       String?
  issuedDate    DateTime
  issuedById    String
  documentId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee    @relation(fields: [employeeId], references: [id])
  document FileObject? @relation(fields: [documentId], references: [id])

  @@index([employeeId, issuedDate])
  @@index([level])
  @@index([documentId])
}

model JobDescription {
  id             String  @id @default(cuid(2))
  companyId      String?
  positionId     String?
  title          String
  /// Printed as written, e.g. "KWI – Riyadh".
  department     String?
  reportsTo      String?
  oversees       String?
  /// The six lists of the company's job description template, one item per
  /// line: duties (organizational, departmental) and the desired profile.
  organizational String?
  departmental   String?
  education      String?
  experience     String?
  skills         String?
  others         String?
  isActive       Boolean @default(true)
  version        Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company?  @relation(fields: [companyId], references: [id])
  position Position? @relation(fields: [positionId], references: [id])

  jobOffers JobOffer[]

  @@index([companyId, isActive])
  @@index([positionId])
}

model JobOffer {
  id               String  @id @default(cuid(2))
  companyId        String
  candidateName    String
  candidateEmail   String?
  candidatePhone   String?
  positionId       String?
  jobDescriptionId String?

  /// The employment offer letter, as printed.
  salutation        String    @default("Mr.")
  /// PASSPORT or IQAMA — whichever document the candidate has.
  candidateIdType   String?
  candidateIdNumber String?
  candidateAddress  String?
  offerDate         DateTime?
  /// "Our Ref.", e.g. KWI/17/26 — assigned on create when left blank.
  refNo             String?

  basicSalary        Decimal? @db.Decimal(12, 2)
  housingAllowance   Decimal? @db.Decimal(12, 2)
  transportAllowance Decimal? @db.Decimal(12, 2)
  mobileAllowance    Decimal? @db.Decimal(12, 2)

  /// Terms, each one of a fixed set of choices (validated by Zod).
  contractYears     Int     @default(1)
  probationDays     Int     @default(90)
  familyStatus      String  @default("WITHOUT_FAMILY")
  leavePlan         String  @default("30_AFTER_1Y")
  ticketCover       String  @default("SELF")
  /// The vacation ticket's destination, e.g. "Amman".
  ticketDestination String?
  medicalCover      String  @default("SELF")

  /// The total package (sum of the four parts above when they are given).
  proposedSalary      Decimal?  @db.Decimal(14, 2)
  currency            String    @default("SAR")
  benefits            Json?
  proposedJoiningDate DateTime?

  status              OfferStatus @default(DRAFT)
  sentAt              DateTime?
  decidedAt           DateTime?
  convertedEmployeeId String?
  /// The interview the candidate came through, if any.
  interviewId         String?
  notes               String?

  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company           Company              @relation(fields: [companyId], references: [id])
  position          Position?            @relation(fields: [positionId], references: [id])
  jobDescription    JobDescription?      @relation(fields: [jobDescriptionId], references: [id])
  convertedEmployee Employee?            @relation("OfferConvertedEmployee", fields: [convertedEmployeeId], references: [id])
  interview         InterviewEvaluation? @relation(fields: [interviewId], references: [id])

  @@index([companyId, status])
  @@index([positionId])
  @@index([jobDescriptionId])
  @@index([convertedEmployeeId])
  @@index([interviewId])
}

enum TimesheetGroup {
  ALL
  NON_SAUDI
  SAUDI
}

/// A monthly attendance sheet, after the company's TIME SHEET: one row per
/// employee, one column per day from the 16th of the previous month to the
/// 15th of `month`. Printed, signed by management, and the signed copy
/// uploaded back against it.
model Timesheet {
  id           String         @id @default(cuid(2))
  /// The month it is named for (first day); covers 16th of the month before to the 15th.
  month        DateTime       @db.Date
  /// As printed above the sheet's file name, e.g. "KWI & KMI".
  title        String
  companyIds   String[]
  group        TimesheetGroup @default(NON_SAUDI)
  signedFileId String?        @unique
  signedAt     DateTime?
  createdById  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  signedFile FileObject?      @relation("TimesheetSigned", fields: [signedFileId], references: [id])
  entries    TimesheetEntry[]

  @@index([month])
}

/// One employee's row on a timesheet.
model TimesheetEntry {
  id            String   @id @default(cuid(2))
  timesheetId   String
  employeeId    String
  sortOrder     Int      @default(0)
  /// "FRI" or "FRI_SAT": the weekly days off printed in grey.
  weekend       String   @default("FRI")
  /// One code per day of the period: P A V S L FRI SAT, or "" outside employment.
  days          Json
  /// One number per day: overtime hours, or delay minutes on a Saudi sheet.
  extra         Json
  /// Food allowance for the month in SAR, typed on the sheet.
  foodAllowance Decimal? @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  timesheet Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  employee  Employee  @relation(fields: [employeeId], references: [id])

  @@unique([timesheetId, employeeId])
  @@index([employeeId])
}

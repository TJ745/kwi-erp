# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. NEVER commit a filled-in file.
# Every variable here is validated at boot by src/lib/env.ts — a missing or
# malformed value fails the build/start rather than surfacing at runtime.
# ---------------------------------------------------------------------------

# --- Database (Neon) -------------------------------------------------------
# Pooled connection (host contains "-pooler"), used by the app at runtime.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Direct connection for migrations — the SAME host WITHOUT "-pooler".
# Prisma Migrate needs a real session; a pooled connection breaks advisory locks.
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# --- Application -----------------------------------------------------------
APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Better Auth -----------------------------------------------------------
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET="replace-me-with-32-random-bytes-base64"
BETTER_AUTH_URL="http://localhost:3000"

# --- Password Vault --------------------------------------------------------
# Key Encryption Key. MUST decode to exactly 32 bytes.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# WARNING: losing this key makes every stored credential permanently
# unrecoverable by design. Back it up in the company offline secret store.
# Never commit it, never log it, never place it behind NEXT_PUBLIC_.
VAULT_KEK_V1="replace-me-with-32-random-bytes-base64"
# Active key version used for new encryptions. Bump only during key rotation.
VAULT_KEK_ACTIVE_VERSION="1"

# --- File storage (UploadThing) --------------------------------------------
# Server-only token. At boot the app asserts the upload routes' ACL declarations
# match UPLOADTHING_TIER below, in both directions.
UPLOADTHING_TOKEN="replace-me"

# Storage tier — the single switch for file privacy (docs/SECURITY.md §6.0).
#   free : UploadThing's free plan rejects private ACLs, so stored documents are
#          readable by anyone holding the object URL. The app never discloses
#          that URL (downloads stream through /api/files/[id]), but a leaked one
#          needs no session. This is the current, accepted setting.
#   pro  : objects are private; reads go through a short-lived signed URL.
# Upgrading is this line and nothing else.
UPLOADTHING_TIER="free"

# Required to run UPLOADTHING_TIER=free with NODE_ENV=production. Separate on
# purpose, so a development default cannot reach production by being copied.
ACCEPT_PUBLIC_FILE_STORAGE="false"

# --- Cron (Vercel Cron -> /api/cron/*) -------------------------------------
# Compared with timing-safe equality on every cron request.
CRON_SECRET="replace-me-with-random-string"

# --- Seed (development only) ----------------------------------------------
# The seed refuses to run in production unless ALLOW_PRODUCTION_SEED=true.
SEED_ADMIN_EMAIL="admin@example.local"
SEED_ADMIN_PASSWORD="ChangeMe-Dev-Only-123!"
